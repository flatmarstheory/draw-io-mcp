        <mxCell id="edge_2" value="" edge="1" parent="1" source="review" target="decision" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Helvetica;fontSize=12;endArrow=block;endFill=1;">
          
          
          <mxGeometry relative="1" as="geometry"/>
          
        
