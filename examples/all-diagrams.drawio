        <mxCell id="start" value="Start" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=50;">
          
          
          <mxGeometry x="30" y="90" width="160" height="70" as="geometry"/>
          
        
        </mxCell>
        
        
        <mxCell id="review" value="Review request" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Helvetica;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;">
          
          
