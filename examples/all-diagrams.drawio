
<mxfile host="draw-io-mcp">
  <diagram id="page-1" name="Approval workflow">
    
    
    <mxGraphModel grid="1" gridSize="10" guides="1" connect="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827">
      
      
      <root>
        
        
        <mxCell id="0"/>
        
        
